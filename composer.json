{
    "name": "omnidrive/sftp",
    "type": "library",
    "description": "Omnidrive SFTP: a directory of an SFTP server, over SSH, as an omnidrive drive, through league/flysystem-sftp-v3 (phpseclib 3, pure PHP) - a password, a private key or the SSH agent, the server's key checked, Unix modes.",
    "keywords": ["storage", "sftp", "ssh", "phpseclib", "flysystem", "omnidrive"],
    "homepage": "https://github.com/glitchr-studio/omnidrive-sftp",
    "license": "MIT",
    "authors": [{"name": "Marco Meyer", "email": "marco.meyer@glitchr.io"}],
    "require": {
        "php": ">=8.2",
        "league/flysystem-sftp-v3": "^3.0",
        "omniscient/omnidrive": "^1.0@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {"Omnidrive\\Sftp\\": ""},
        "exclude-from-classmap": ["/Tests/"]
    },
    "autoload-dev": {
        "psr-4": {"Omnidrive\\Sftp\\Tests\\": "Tests/"}
    },
    "config": {"sort-packages": true}
}
